{
  "routes": [
    {
      "route": "/404",
      "rewrite": "/404.html"
    },
    {
      "route": "/servicios/microsoft-365",
      "redirect": "/servicios/seguridad-microsoft-365/",
      "statusCode": 301
    },
    {
      "route": "/servicios/microsoft-365/",
      "redirect": "/servicios/seguridad-microsoft-365/",
      "statusCode": 301
    },
    {
      "route": "/servicios/auditoria-cloud",
      "redirect": "/#pricing",
      "statusCode": 301
    },
    {
      "route": "/servicios/auditoria-cloud/",
      "redirect": "/#pricing",
      "statusCode": 301
    },
    {
      "route": "/servicios/migracion-azure",
      "redirect": "/",
      "statusCode": 301
    },
    {
      "route": "/servicios/migracion-azure/",
      "redirect": "/",
      "statusCode": 301
    },
    {
      "route": "/servicios/devops-automatizacion",
      "redirect": "/",
      "statusCode": 301
    },
    {
      "route": "/servicios/devops-automatizacion/",
      "redirect": "/",
      "statusCode": 301
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/images/*.{png,jpg,gif,svg}",
      "/css/*"
    ]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html"
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Content-Security-Policy": "default-src 'self' 'unsafe-inline' 'unsafe-eval'; img-src 'self' data: https:;"
  },
  "mimeTypes": {
    ".json": "application/json"
  }
}