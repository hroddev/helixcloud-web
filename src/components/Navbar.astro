---
import { siteData } from "../siteData";

const isHome = Astro.url.pathname === "/";

const links = [
  {
    name: "Servicios",
    href: isHome ? "#services" : "/#services",
    children: siteData.servicePages.map((s) => ({
      name: s.navLabel,
      href: `/servicios/${s.slug}/`,
    })),
  },
  { name: "Precios", href: isHome ? "#pricing" : "/#pricing" },
  { name: "Resultados", href: isHome ? "#success-cases" : "/#success-cases" },
  { name: "Contacto", href: isHome ? "#contact" : "/#contact" },
];
---

<nav
  class="fixed inset-x-0 z-50 top-0 border-b border-white/5 bg-gray-950/80 backdrop-blur-md transition-all duration-300"
  id="navbar"
>
  <div
    class="max-w-screen-xl flex items-center justify-between mx-auto px-4 py-4 md:px-12"
  >
    <a href="/" class="flex items-center transition-opacity duration-500" id="logo">
      <!-- Logo -->
      <img
        src="/helix-cloud-logo.webp"
        class="h-12 md:h-16 w-auto transition-transform hover:scale-105"
        alt="Helix Cloud Logo"
      />
    </a>
    <div
      class="flex items-center md:order-2 space-x-2 md:space-x-0 rtl:space-x-reverse"
    >
      <a
        href={isHome ? "#contact" : "/#contact"}
        class="hidden sm:block text-white bg-blue-600 hover:bg-blue-700 focus:ring-4 focus:outline-none focus:ring-blue-800 font-medium rounded-lg text-xs md:text-sm px-3 py-2 md:px-5 md:py-2.5 text-center transition-all"
      >
        Contacto
      </a>
      <button
        data-collapse-toggle="navbar-sticky"
        type="button"
        class="inline-flex items-center p-2 w-9 h-9 justify-center text-sm text-gray-400 rounded-lg md:hidden hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-gray-600"
        aria-controls="navbar-sticky"
        aria-expanded="false"
      >
        <span class="sr-only">Open main menu</span>
        <svg
          class="w-5 h-5"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 17 14"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M1 1h15M1 7h15M1 13h15"></path>
        </svg>
      </button>
    </div>
    <div
      class="items-center justify-between hidden w-full md:flex md:w-auto md:order-1"
      id="navbar-sticky"
    >
      <ul
        class="flex flex-col p-4 md:p-0 mt-4 font-medium border border-white/10 rounded-2xl bg-gray-950/90 md:bg-transparent backdrop-blur-lg md:backdrop-blur-0 md:space-x-8 rtl:space-x-reverse md:flex-row md:mt-0 md:border-0"
      >
        {
          links.map((link) => (
            <li class={link.children ? "relative group" : ""}>
              <a
                href={link.href}
                class={`flex items-center gap-1 py-3 px-4 md:p-0 text-gray-400 rounded-xl hover:bg-white/5 md:hover:bg-transparent md:hover:text-blue-500 transition-all duration-300 ${link.name === "Contacto" ? "md:hidden" : ""}`}
              >
                {link.name}
                {link.children && (
                  <svg
                    class="w-3 h-3"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 9l-7 7-7-7"
                    />
                  </svg>
                )}
              </a>
              {link.children && (
                <ul
                  class="pl-4 md:absolute md:top-full md:left-0 md:mt-2 md:w-64 md:rounded-xl md:border md:border-white/10 md:bg-gray-950/95 md:backdrop-blur-lg md:shadow-xl md:p-2 md:opacity-0 md:invisible md:group-hover:opacity-100 md:group-hover:visible md:transition-all md:duration-200"
                >
                  {link.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class="block px-4 py-2 rounded-lg text-sm text-gray-400 hover:text-white hover:bg-white/5 transition-colors"
                      >
                        {child.name}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</nav>

<script>
  // Mobile menu toggle
  const btn = document.querySelector('[data-collapse-toggle="navbar-sticky"]');
  const menu = document.getElementById("navbar-sticky");
  const links = menu?.querySelectorAll("a");
  const logo = document.getElementById("logo");

  function closeMenu() {
    if (menu && !menu.classList.contains("hidden")) {
      menu.classList.add("hidden");
      if (logo) logo.style.opacity = "1";
      if (btn) btn.setAttribute("aria-expanded", "false");
    }
  }

  if (btn && menu) {
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      const isHidden = menu.classList.contains("hidden");
      menu.classList.toggle("hidden");
      if (logo) {
        logo.style.opacity = isHidden ? "0" : "1";
      }
      btn.setAttribute("aria-expanded", isHidden ? "true" : "false");
    });

    // Close on click outside
    document.addEventListener("click", (e) => {
      const target = e.target as Node;
      if (
        !menu.classList.contains("hidden") &&
        !menu.contains(target) &&
        !btn.contains(target)
      ) {
        closeMenu();
      }
    });

    // Close on scroll
    let lastScrollY = window.scrollY;
    window.addEventListener(
      "scroll",
      () => {
        if (Math.abs(window.scrollY - lastScrollY) > 10) {
          closeMenu();
        }
        lastScrollY = window.scrollY;
      },
      { passive: true },
    );

    // Close when a link is clicked
    links?.forEach((link) => {
      link.addEventListener("click", () => {
        closeMenu();
      });
    });
  }
</script>
