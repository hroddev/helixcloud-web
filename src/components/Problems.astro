---
import { siteData } from "../siteData";
---

<section id="problemas" class="py-24 bg-black relative">
    <div class="container mx-auto px-6 md:px-12">
        <div class="text-center mb-16">
            <h2 class="text-3xl md:text-5xl font-bold mb-4 text-white">
                {siteData.problemsTitle}
            </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
            {
                siteData.problems.map((problem) => (
                    <div class="p-8 rounded-2xl bg-[#050505] border border-white/10 hover:border-blue-500/30 transition-all duration-300">
                        <h3 class="text-lg font-bold mb-3 text-white">
                            {problem.title}
                        </h3>
                        <p class="text-gray-400 text-sm leading-relaxed">
                            {problem.description}
                        </p>
                    </div>
                ))
            }
        </div>
    </div>
</section>
