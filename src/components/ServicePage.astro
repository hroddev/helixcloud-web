---
import Layout from "../layouts/Layout.astro";
import Navbar from "./Navbar.astro";
import Footer from "./Footer.astro";
import { siteData } from "../siteData";

interface BreakdownItem {
	title: string;
	description: string;
}

interface ServicePageData {
	slug: string;
	navLabel: string;
	title: string;
	metaDescription: string;
	heading: string;
	tagline: string;
	serviceType: string;
	overview: string[];
	breakdown: BreakdownItem[];
	techStack: string[];
	benefits: string[];
	ctaLabel: string;
	ctaHref: string;
}

interface Props {
	service: ServicePageData;
}

const { service } = Astro.props;

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "ITService",
	name: service.heading,
	description: service.metaDescription,
	serviceType: service.serviceType,
	areaServed: ["Panama", "LATAM"],
	provider: {
		"@type": "ProfessionalService",
		name: "Helix Cloud",
		url: siteData.siteUrl,
		areaServed: ["Panama", "LATAM"],
		sameAs: [siteData.linkedinUrl, siteData.githubUrl],
	},
};
---

<Layout
	title={service.title}
	description={service.metaDescription}
	ogType="article"
	jsonLd={JSON.stringify(jsonLd)}
>
	<Navbar />

	<main class="pt-24 pb-16">
		<!-- Hero -->
		<section class="relative overflow-hidden py-16 md:py-24">
			<div
				class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-blue-600/10 rounded-full blur-[100px] -z-10"
			>
			</div>
			<div class="container mx-auto px-6 md:px-12 text-center">
				<a
					href="/#services"
					class="inline-flex items-center gap-2 text-sm text-gray-400 hover:text-blue-400 transition-colors mb-8"
				>
					<svg
						class="w-4 h-4"
						fill="none"
						stroke="currentColor"
						viewBox="0 0 24 24"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M15 19l-7-7 7-7"
						/>
					</svg>
					Volver a servicios
				</a>
				<h1
					class="text-3xl md:text-5xl font-bold mb-6 text-white leading-tight"
				>
					{service.heading}
				</h1>
				<p
					class="text-gray-400 max-w-2xl mx-auto text-base md:text-lg mb-10"
				>
					{service.tagline}
				</p>
				<div
					class="flex flex-col sm:flex-row items-center justify-center gap-4"
				>
					<a
						href={service.ctaHref}
						class="px-8 py-4 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-semibold rounded-xl shadow-lg shadow-blue-900/30 transition-all hover:scale-105"
					>
						{service.ctaLabel}
					</a>
					<a
						href="/#pricing"
						class="px-8 py-4 glass text-white font-semibold rounded-xl border border-white/10 hover:bg-white/10 transition-all"
					>
						Ver planes
					</a>
				</div>
			</div>
		</section>

		<!-- Overview -->
		<section class="py-12">
			<div class="container mx-auto px-6 md:px-12 max-w-4xl">
				<div class="glass p-8 md:p-12 rounded-3xl border border-white/10 space-y-6">
					{service.overview.map((paragraph) => (
						<p class="text-gray-300 leading-relaxed">
							{paragraph}
						</p>
					))}
				</div>
			</div>
		</section>

		<!-- Breakdown -->
		<section class="py-12">
			<div class="container mx-auto px-6 md:px-12">
				<h2 class="text-2xl md:text-4xl font-bold mb-10 text-center text-white">
					Qué <span class="text-gradient">incluye</span>
				</h2>
				<div
					class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto"
				>
					{service.breakdown.map((item) => (
						<div
							class="p-6 rounded-2xl bg-black border border-white/10 hover:border-blue-500/30 transition-all duration-300"
						>
							<h3 class="text-lg font-bold mb-2 text-white">
								{item.title}
							</h3>
							<p class="text-gray-400 text-sm leading-relaxed">
								{item.description}
							</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- Tech stack + Benefits -->
		<section class="py-12">
			<div class="container mx-auto px-6 md:px-12 max-w-5xl">
				<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
					<div
						class="p-8 rounded-2xl bg-black border border-white/10"
					>
						<h3 class="text-xl font-bold mb-6 text-white">
							Stack de <span class="text-gradient">tecnología</span>
						</h3>
						<div class="flex flex-wrap gap-2">
							{service.techStack.map((tech) => (
								<span
									class="text-sm px-3 py-1 bg-blue-500/10 text-blue-400 rounded-full border border-blue-500/20"
								>
									{tech}
								</span>
							))}
						</div>
					</div>
					<div
						class="p-8 rounded-2xl bg-black border border-white/10"
					>
						<h3 class="text-xl font-bold mb-6 text-white">
							Beneficios <span class="text-gradient">clave</span>
						</h3>
						<ul class="space-y-3">
							{service.benefits.map((benefit) => (
								<li class="flex items-start gap-3">
									<svg
										class="w-5 h-5 text-green-400 flex-shrink-0 mt-0.5"
										fill="currentColor"
										viewBox="0 0 20 20"
									>
										<path
											fill-rule="evenodd"
											d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
											clip-rule="evenodd"
										/>
									</svg>
									<span class="text-gray-300 text-sm">
										{benefit}
									</span>
								</li>
							))}
						</ul>
					</div>
				</div>
			</div>
		</section>

		<!-- CTA -->
		<section class="py-16">
			<div class="container mx-auto px-6 md:px-12 text-center">
				<div
					class="max-w-3xl mx-auto glass p-10 md:p-14 rounded-3xl border border-white/10"
				>
					<h2 class="text-2xl md:text-3xl font-bold mb-4 text-white">
						¿Listo para <span class="text-gradient">empezar</span>?
					</h2>
					<p class="text-gray-400 mb-8">
						Diagnóstico gratuito de 30 minutos. Te respondemos en menos
						de 24 horas.
					</p>
					<a
						href={service.ctaHref}
						class="inline-block px-8 py-4 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-semibold rounded-xl shadow-lg shadow-blue-900/30 transition-all hover:scale-105"
					>
						{service.ctaLabel}
					</a>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>
