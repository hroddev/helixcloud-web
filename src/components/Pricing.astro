---
import { siteData } from "../siteData";
---

<section id="pricing" class="py-24 bg-[#050505] relative overflow-hidden">
    <!-- Decorator -->
    <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-blue-600/10 rounded-full blur-[100px] -z-10"
    >
    </div>

    <div class="container mx-auto px-6 md:px-12">
        <div class="text-center mb-16">
            <h2 class="text-3xl md:text-5xl font-bold mb-4 text-white">
                Paquetes con precio <span class="text-gradient">visible</span>
            </h2>
            <p class="text-gray-400 max-w-2xl mx-auto">
                Todo precio parte de "Desde" y cada paquete indica claramente qué no incluye.
            </p>
        </div>

        <!-- Free Diagnostic Banner -->
        <div class="max-w-3xl mx-auto mb-16 p-8 rounded-2xl border border-blue-500/30 bg-blue-500/5 text-center">
            <h3 class="text-xl font-bold text-white mb-2">{siteData.freeDiagnostic.title}</h3>
            <p class="text-gray-400 text-sm mb-6">{siteData.freeDiagnostic.description}</p>
            <div class="mb-6">
                <span class="text-3xl font-bold text-white">{siteData.freeDiagnostic.price}</span>
                <span class="text-gray-400 ml-2 text-sm">{siteData.freeDiagnostic.duration}</span>
            </div>
            <a
                href={siteData.whatsappUrl}
                target="_blank"
                rel="noopener"
                class="inline-block py-3 px-8 rounded-lg font-semibold transition-all bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white shadow-lg shadow-blue-900/30 hover:scale-105"
            >
                Agendar por WhatsApp →
            </a>
        </div>

        <!-- One-time packages -->
        <div class="mb-20">
            <div class="text-center mb-10">
                <h3 class="text-2xl md:text-3xl font-bold text-white mb-3">
                    Proyectos <span class="text-gradient">puntuales</span>
                </h3>
                <p class="text-gray-400 max-w-2xl mx-auto">
                    Pago único, alcance definido, entregable claro.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
                {siteData.oneTimePackages.map((pkg) => (
                    <div class="relative rounded-2xl border border-white/10 bg-black p-8 flex flex-col transition-all duration-300 hover:border-blue-500/30">
                        <h4 class="text-xl font-bold text-white mb-2">{pkg.name}</h4>
                        <p class="text-gray-400 text-sm mb-6">{pkg.description}</p>

                        <div class="mb-4">
                            <span class="text-3xl font-bold text-white">{pkg.price}</span>
                            <span class="text-gray-400 ml-2 text-sm">{pkg.period}</span>
                        </div>

                        <p class="text-gray-500 text-xs mb-6">{pkg.notIncluded}</p>

                        {pkg.guarantee && (
                            <p class="text-green-400 text-xs mb-6 font-semibold">✓ {pkg.guarantee}</p>
                        )}

                        <a
                            href={pkg.href}
                            data-service={pkg.href === "#contact" ? pkg.key : undefined}
                            class="mt-auto w-full py-3 px-6 rounded-lg font-semibold transition-all text-center block bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white shadow-lg shadow-blue-900/30 hover:scale-105"
                        >
                            {pkg.cta}
                        </a>
                    </div>
                ))}
            </div>
        </div>

        <!-- Monthly plans -->
        <div>
            <div class="text-center mb-10">
                <h3 class="text-2xl md:text-3xl font-bold text-white mb-3">
                    Planes <span class="text-gradient">mensuales</span>
                </h3>
                <p class="text-gray-400 max-w-2xl mx-auto">
                    Para cuando necesitas continuidad, no solo un proyecto.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
                {siteData.monthlyPlans.map((plan) => (
                    <div class="relative rounded-2xl border border-white/10 bg-black p-8 flex flex-col transition-all duration-300 hover:border-blue-500/30">
                        <h4 class="text-xl font-bold text-white mb-2">{plan.name}</h4>
                        <p class="text-gray-400 text-sm mb-6">{plan.description}</p>

                        <div class="mb-4">
                            <span class="text-3xl font-bold text-white">{plan.price}</span>
                            <span class="text-gray-400 ml-2 text-sm">{plan.period}</span>
                            {plan.priceSuffix && (
                                <div class="text-gray-400 text-xs mt-1">{plan.priceSuffix}</div>
                            )}
                        </div>

                        <p class="text-gray-500 text-xs mb-6">{plan.notIncluded}</p>

                        <a
                            href={plan.href}
                            data-service={plan.href === "#contact" ? plan.key : undefined}
                            class="mt-auto w-full py-3 px-6 rounded-lg font-semibold transition-all text-center block glass text-white hover:bg-white/10 border border-white/10"
                        >
                            {plan.cta}
                        </a>
                    </div>
                ))}
            </div>
        </div>

        <!-- Response time note -->
        <div class="mt-16 text-center max-w-2xl mx-auto">
            <p class="text-gray-400 text-sm">{siteData.responseTimeNote}</p>
        </div>
    </div>
</section>
