---
import { retail } from "../data/sections/retail";
---

<main class="pt-24 pb-16">
	<!-- Hero -->
	<section class="relative overflow-hidden py-16 md:py-24">
		<div
			class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-blue-600/10 rounded-full blur-[100px] -z-10"
		>
		</div>
		<div class="container mx-auto px-6 md:px-12 text-center">
			<span
				class="inline-flex items-center gap-2 px-3 py-1 rounded-full glass mb-6 border border-white/10 text-sm font-light tracking-wide text-gray-300"
			>
				{retail.eyebrow}
			</span>
			<h1 class="text-3xl md:text-5xl font-bold mb-6 text-white leading-tight max-w-3xl mx-auto">
				{retail.headline}
			</h1>
			<p class="text-gray-400 max-w-2xl mx-auto text-base md:text-lg mb-10">
				{retail.subheadline}
			</p>
			<a
				href={retail.plan.cta.href}
				target="_blank"
				rel="noopener"
				class="inline-block px-8 py-4 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-semibold rounded-xl shadow-lg shadow-blue-900/30 transition-all hover:scale-105"
			>
				{retail.plan.cta.label} →
			</a>
		</div>
	</section>

	<!-- Problems -->
	<section class="py-12">
		<div class="container mx-auto px-6 md:px-12">
			<h2 class="text-2xl md:text-4xl font-bold mb-10 text-center text-white">
				Frases que <span class="text-gradient">reconoces</span>
			</h2>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto">
				{retail.problems.map((problem) => (
					<div class="p-8 rounded-2xl bg-black border border-white/10 hover:border-blue-500/30 transition-all duration-300">
						<h3 class="text-lg font-bold mb-3 text-white">{problem.title}</h3>
						<p class="text-gray-400 text-sm leading-relaxed">{problem.body}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Capabilities -->
	<section class="py-12">
		<div class="container mx-auto px-6 md:px-12">
			<h2 class="text-2xl md:text-4xl font-bold mb-10 text-center text-white">
				Qué <span class="text-gradient">resolvemos</span>
			</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
				{retail.capabilities.map((capability) => (
					<div class="p-6 rounded-2xl bg-black border border-white/10 hover:border-blue-500/30 transition-all duration-300">
						<h3 class="text-base font-bold mb-2 text-white">{capability.title}</h3>
						<p class="text-gray-400 text-sm leading-relaxed">{capability.body}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Plan -->
	<section class="py-16" id="plan">
		<div class="container mx-auto px-6 md:px-12">
			<div class="max-w-2xl mx-auto rounded-2xl border border-white/10 bg-[#050505] p-8 md:p-12">
				<h2 class="text-xl md:text-2xl font-bold text-white mb-2">{retail.plan.name}</h2>
				<div class="mb-8">
					<span class="text-3xl font-bold text-white">{retail.plan.price}</span>
				</div>

				<h3 class="text-sm font-bold text-gray-300 uppercase tracking-wide mb-3">Incluye</h3>
				<ul class="space-y-3 mb-8">
					{retail.plan.includes.map((item) => (
						<li class="flex items-start gap-3">
							<svg class="w-5 h-5 text-green-400 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
								<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
							</svg>
							<span class="text-gray-300 text-sm">{item}</span>
						</li>
					))}
				</ul>

				<h3 class="text-sm font-bold text-gray-300 uppercase tracking-wide mb-3">No incluye</h3>
				<ul class="space-y-2 mb-10">
					{retail.plan.excludes.map((item) => (
						<li class="text-gray-500 text-sm">— {item}</li>
					))}
				</ul>

				<a
					href={retail.plan.cta.href}
					target="_blank"
					rel="noopener"
					class="block w-full text-center py-3 px-6 rounded-lg font-semibold transition-all bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white shadow-lg shadow-blue-900/30 hover:scale-105"
				>
					{retail.plan.cta.label}
				</a>
			</div>
		</div>
	</section>
</main>
