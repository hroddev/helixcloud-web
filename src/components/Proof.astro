---
interface ProofData {
	badge: string;
	industry: string;
	profile: string;
	challenge: string;
	solution: string;
	result: string;
}

interface Props {
	proof: ProofData;
	id?: string;
}

const { proof, id = "casos" } = Astro.props;
---

<section id={id} class="py-24 bg-[#050505]">
    <div class="container mx-auto px-6 md:px-12">
        <div class="max-w-3xl mx-auto p-8 md:p-12 rounded-2xl bg-black border border-white/10 relative">
            <span class="inline-block px-3 py-1 rounded-full bg-yellow-500/10 border border-yellow-500/30 text-yellow-400 text-xs font-semibold mb-6">
                {proof.badge}
            </span>

            <div class="inline-block px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 mb-4 ml-2">
                <span class="text-sm text-blue-400 font-semibold">{proof.industry}</span>
            </div>
            <p class="text-gray-400 text-xs mb-8">{proof.profile}</p>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div>
                    <h3 class="text-sm font-bold text-gray-300 uppercase tracking-wide mb-2">Desafío</h3>
                    <p class="text-gray-500 text-sm leading-relaxed italic">{proof.challenge}</p>
                </div>
                <div>
                    <h3 class="text-sm font-bold text-gray-300 uppercase tracking-wide mb-2">Solución</h3>
                    <p class="text-gray-500 text-sm leading-relaxed italic">{proof.solution}</p>
                </div>
                <div>
                    <h3 class="text-sm font-bold text-gray-300 uppercase tracking-wide mb-2">Resultado</h3>
                    <p class="text-gray-500 text-sm leading-relaxed italic">{proof.result}</p>
                </div>
            </div>
        </div>
    </div>
</section>
