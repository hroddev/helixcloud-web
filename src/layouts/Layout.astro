---
import { siteData } from "../siteData";
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
	ogImage?: string;
	ogType?: string;
	jsonLd?: string;
}

const {
	title,
	description = siteData.siteDescription,
	ogImage = "/helix-cloud-logo.webp",
	ogType = "website",
	jsonLd,
} = Astro.props;

// Schema.org global (ProfessionalService) para SEO Local B2B
const globalJsonLd = {
	"@context": "https://schema.org",
	"@type": "ProfessionalService",
	name: "Helix Cloud",
	url: siteData.siteUrl,
	description: siteData.siteDescription,
	areaServed: [{ "@type": "Country", name: "Panama" }],
	address: {
		"@type": "PostalAddress",
		addressLocality: "Ciudad de Panamá",
		addressCountry: "PA",
	},
	hasOfferCatalog: {
		"@type": "OfferCatalog",
		name: "Servicios de Helix Cloud",
		itemListElement: [
			...siteData.oneTimePackages.map((pkg) => ({
				"@type": "Offer",
				name: pkg.name,
				description: pkg.description,
				priceCurrency: "USD",
				itemOffered: { "@type": "Service", name: pkg.name },
			})),
			...siteData.monthlyPlans.map((plan) => ({
				"@type": "Offer",
				name: plan.name,
				description: plan.description,
				priceCurrency: "USD",
				itemOffered: { "@type": "Service", name: plan.name },
			})),
		],
	},
	sameAs: [siteData.linkedinUrl, siteData.githubUrl],
};
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="canonical" href={new URL(Astro.url.pathname, siteData.siteUrl).href} />
		<link rel="alternate" hreflang="es-PA" href={new URL(Astro.url.pathname, siteData.siteUrl).href} />
		<link rel="alternate" hreflang="x-default" href={new URL(Astro.url.pathname, siteData.siteUrl).href} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<!-- OpenGraph -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={new URL(Astro.url.pathname, siteData.siteUrl).href} />
		<meta property="og:image" content={new URL(ogImage, siteData.siteUrl).href} />
		<meta property="og:site_name" content="Helix Cloud" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL(ogImage, siteData.siteUrl).href} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<script type="application/ld+json" set:html={JSON.stringify(globalJsonLd)} />
		{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
	</head>
	<body
		id="top"
		class="bg-gray-950 text-white font-sans selection:bg-blue-500/30"
	>
		<slot />
	</body>
</html>
